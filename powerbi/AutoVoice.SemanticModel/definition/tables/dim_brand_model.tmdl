table dim_brand_model
	lineageTag: f2869559-29ed-5b36-b02d-125697fdd778

	column model_key
		dataType: int64
		formatString: 0
		lineageTag: 9882129f-e724-57b9-9051-748adbb27016
		summarizeBy: none
		sourceColumn: model_key

	column brand
		dataType: string
		lineageTag: 41f73495-dd8c-5ce0-b404-9e95f1401a87
